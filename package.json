{
  "name": "labs",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "create-app": "node tools/create-app/index.mjs",
    "deploy-app": "node tools/deploy/index.mjs",
    "quiz": "node tools/quiz-gen/index.mjs",
    "quiz:publish": "node tools/quiz-gen/index.mjs publish apps/study-buddy/content/authored/*.json",
    "quiz:check": "node tools/quiz-gen/index.mjs publish apps/study-buddy/content/authored/*.json --check"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vercel": "^59.11.7"
  }
}
