{
  "name": "@labs/quiz-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "문제 스키마와 검증. 앱은 ./runtime 만 쓴다 (zod·node:crypto 미포함).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@labs/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
